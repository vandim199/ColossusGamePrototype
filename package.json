{
  "name": "colossus-mind-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Playable browser prototype of the board game Colossus: Mind Game (GDD v2.5)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx src/sim/cli.ts",
    "sim:log": "tsx src/sim/peek.ts log"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "trystero": "^0.26.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
